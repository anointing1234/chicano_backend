# Copy to backend/.env and adjust. docker-compose loads this file.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# Add your laptop's LAN IP so a physical phone running Expo Go can reach the API.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,10.0.2.2,192.168.1.50
# Browsers only (Expo Web). Native apps don't need CORS; the dashboard is served by Django itself.
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006
# Production: the dashboard's HTTPS origin, so its forms pass the CSRF check.
CSRF_TRUSTED_ORIGINS=

DATABASE_URL=postgres://chicano:chicano@db:5432/chicano

JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=30

# DEV ONLY: return the OTP in /auth/otp/request/ so you can log in without SMS. Must be false in production.
OTP_DEBUG_RETURN_CODE=true
SMS_BACKEND=console        # console | twilio
PUSH_BACKEND=console       # console | expo | fcm
PAYMENT_GATEWAY=dummy      # dummy | paystack   (dummy: card tokens starting with "fail_" are declined)

DISPATCH_OFFER_SECONDS=15
DISPATCH_RADIUS_KM=5
DISPATCH_MAX_OFFERS=3
SHARE_BASE_URL=https://chicanocruise.com/t/
